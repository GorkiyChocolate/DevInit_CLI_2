redis:
  name: redis
  description: Redis in-memory data store and cache
  image: redis:7-alpine
  ports:
  - 6379:6379
  environment: null
  volumes:
  - redis_data:/data
  networks:
  - backend_net
  depends_on: null
  restart: unless-stopped
  command:
  - redis-server
  - --appendonly
  - yes
  files: null
  env:
  - REDIS_HOST=localhost
  - REDIS_PORT=6379
  notes:
  - AOF persistence enabled
